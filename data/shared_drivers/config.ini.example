# Copy to /data/shared_drivers/config.ini and edit.
# One section per sensor. The section name is passed to the driver with
# --section (see /data/etc/init.d/*/run).
#
# Common keys
#   service          D-Bus name suffix -> com.victronenergy.tank.<service>
#                    (letters, digits, underscore; must be unique)
#   mac              BLE MAC address of the sensor. Required for the fridge,
#                    optional for the ESP32, and optional for the Mopeka
#                    (empty = pair with the sync button, see below).
#   capacity_l       tank size in litres (ESP32 sends its own capacity)
#   custom_name      name shown in the GUI (can also be changed in the GUI)
#   device_instance  preferred VRM instance; localsettings picks a free one if
#                    taken (instances are per device class: tank / temperature)
#   timeout          seconds without data before the tank shows "disconnected"
#   fluid_type       override, Venus OS enum: 1 fresh water, 2 waste water,
#                    5 black water, 8 LPG ...
#   adapter          Bluetooth adapter, default hci0

[mopeka_standard]
service = mopeka_standard
# Leave empty and press the sync button on the sensor once: the driver pairs
# with it and remembers the MAC (ignores the neighbours' sensors). To pair a
# different sensor later, clear the stored MAC and restart:
#   dbus -y com.victronenergy.settings /Settings/Devices/mopeka_standard/Mac SetValue ''
#   svc -t /service/mopeka_standard
# Or set it here to skip pairing (overrides the stored one).
mac =
custom_name = Gas bottle
# 11 kg bottle ~ 27 L; 5 kg ~ 12 L. Only used for /Remaining.
capacity_l = 27
# 1.0 = pure propane (DE/NL/Scandinavia), ~0.3-0.4 for summer mixes in FR/ES/IT
propane_ratio = 1.0
# Distance the sensor measures (mm of liquid) at empty and at 100 %.
# Watch /Mopeka/DistanceMm in dbus-spy with an empty and a freshly filled
# bottle and put the numbers here. A full bottle is filled to ~80 % volume.
empty_mm = 38
full_mm = 254
# Optional bottle shape, relative to the calibration: fraction of the way
# from empty_mm to full_mm -> percent. Only full_mm has to be measured (the
# reading of a freshly filled bottle). Example: CAMPKO 30 L (24 L usable,
# 300 mm diameter, rounded bottom):
#level_curve = 0:0, 0.05:1.3, 0.10:4.6, 0.15:9.2, 0.194:13.9, 1:100
# Optional, for non-cylindrical bottles: distance_mm:percent pairs. Overrides
# empty_mm/full_mm and level_curve.
#level_table = 20:0, 60:15, 120:45, 180:75, 240:100
median_window = 5
# The sensor's temperature as its own temperature sensor
# (com.victronenergy.temperature.mopeka_standard_temp, shown with the environment sensors).
temperature_service = yes
temperature_name = Gas bottle temperature
# battery, fridge, generic, room, outdoor, waterheater, freezer
temperature_type = outdoor

[esp32_hydro]
service = esp32_hydro
# Must match DEVICE_ID in the firmware
device_id = 1
custom_name = Fresh water
# mac is optional: filtering on device_id is enough, but setting it saves CPU
#mac = 11:22:33:44:55:66
# Publish the DS18B20 water temperature as its own temperature sensor
# (com.victronenergy.temperature.esp32_hydro_temp). Victron documents the
# tank /Temperature path only for Mopeka sensors, so the GUI may not show it
# on this tank; a temperature service always shows up.
temperature_service = yes
temperature_name = Water temperature
# battery, fridge, generic, room, outdoor, waterheater, freezer
temperature_type = generic

[fridge]
# Compressor fridge with the "Alpicool" Bluetooth controller. Run
#   python3 /data/shared_drivers/diagnostics/fridge_probe.py
# first: it lists nearby fridges and checks that yours speaks this protocol.
service = fridge
mac = 11:22:33:44:55:77
# Seconds between status reads. Each read connects for ~2 s; during that time
# the phone app cannot connect (one connection at a time).
poll_interval = 60
# yes = stay connected between polls (faster, but the phone app is locked out)
stay_connected = no
# Show power, eco mode and set points as controls on the GUI's switch pane
control = yes
# auto = freezer if the set point is below 0 C, else fridge
zone1_type = auto
# only used by dual-zone fridges
zone2_type = auto
# Names (Fridge / Freezer) and set point ranges (fridge 0...8 C, freezer -20...-12 C, single -20...20 C)
# are fixed in the driver.

[web]
# The settings page (service web_ui): http://<pi-ip>:8088
# Change fridge, gas, water and battery (dbus-serialbattery) settings in the browser.
# Without a password the page is read-only. install.sh web_ui sets a random one.
password =
port = 8088
bind = 0.0.0.0
# Open the port in the Pi's firewall for the local network (not the internet)
open_firewall = yes

[starlink]
# Starlink tabs on the settings page: dish, energy, data use, outages, speed tests, ping health.
# The Pi must reach the dish, normally at 192.168.100.1 (check: curl http://192.168.100.1/).
enabled = yes
host = 192.168.100.1
# Speed test every N minutes; 0 = only when you press the button. A test moves about 33 MB.
speedtest_interval = 0
# Ping tiles: Name=address, up to 8 (default: Cloudflare, Google, Quad9 and the dish)
#icmp_targets = Cloudflare=1.1.1.1, Google=8.8.8.8, Dish=192.168.100.1, Gateway=100.64.0.1
# Billing cycle day (1-28) and data cap in GB (0 = no cap) for the data-use bar
cycle_day = 1
cap_gb = 0
# Electricity price per kWh for the energy cost (0 = hide) and its currency label
price_per_kwh = 0
currency = EUR
# Record the public IP address (every 5 minutes, through Cloudflare)
wan_check = yes
# Seconds between live readings, and between reads of the dish's 15-minute history
interval = 5
history_interval = 60
# gRPC-web port of the dish
port = 9201

[telegram]
# Notifications to a Telegram chat. Make a bot with @BotFather, send it a message, then fill in
# token and chat_id (the Notifications tab of the settings page walks you through it).
enabled = no
token =
chat_id =
# What you get (all switchable on the page): lithium battery low, any alarm, gas sensor battery,
# leaving the parking spot, Orion XS charging switched on, Starlink events.
#alert_battery = yes
#battery_warn_pct = 20
#battery_alarm_pct = 10
#alert_alarms = yes
#alert_geofence = no
#fence_m = 200
#alert_orion = yes
#alert_freeze = yes
#alert_cold = yes
